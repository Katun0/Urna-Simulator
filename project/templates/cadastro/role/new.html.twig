{% extends 'base.html.twig' %}

{% block title %}Nova Role{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h3 class="card-title mb-0">Criar Novo Perfil de Acesso</h3>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                        {{ form_row(form.name) }}
                        <div class="card mt-3">
                            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                <span>Rotas Permitidas</span>
                                <small class="text-muted">Ative as rotas que este perfil pode acessar</small>
                            </div>
                            <div class="card-body p-0" style="max-height: 400px; overflow-y: auto;">
                                <ul class="list-group list-group-flush">
                                    {% for child in form.routes %}
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            {{ form_label(child, null, {'label_attr': {'class': 'form-check-label flex-grow-1', 'style': 'cursor:pointer'}}) }}
                                            <div class="form-check form-switch">
                                                {{ form_widget(child, {'attr': {'class': 'form-check-input'}}) }}
                                            </div>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                        <div class="d-grid gap-2 mt-4">
                            <button class="btn btn-primary btn-lg">Salvar Perfil</button>
                            <a href="{{ path('app_cadastro_role_index') }}" class="btn btn-outline-secondary">Voltar para a lista</a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
