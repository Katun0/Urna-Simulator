{% extends 'base.html.twig' %}

{% block title %}Análise de Votos{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Apuração dos Votos</h1>
        <div class="text-end">
            {% if finalizada %}
                <span class="badge bg-danger fs-5 me-2">ELEIÇÃO ENCERRADA</span>
            {% else %}
                <span class="badge bg-success fs-5 me-2">ELEIÇÃO EM ANDAMENTO</span>
            {% endif %}
            <span class="badge bg-primary fs-5">Total de Votos: {{ totalVotos }}</span>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}

    <div class="row">
        <!-- Resumo Geral -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Resumo</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Votos Brancos
                            <span class="badge bg-secondary rounded-pill">{{ votosBrancos }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Votos Nulos
                            <span class="badge bg-danger rounded-pill">{{ votosNulos }}</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Resultados por Candidato -->
        <div class="col-md-8 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Candidatos</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Candidato</th>
                                    <th>Número</th>
                                    <th>Partido</th>
                                    <th class="text-center">Votos</th>
                                    <th class="text-center">Percentual</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for res in resultados|sort((a, b) => b.votos <=> a.votos) %}
                                <tr>
                                    <td><strong>{{ res.nome }}</strong></td>
                                    <td>{{ res.numero }}</td>
                                    <td>{{ res.partido }}</td>
                                    <td class="text-center">{{ res.votos }}</td>
                                    <td class="text-center">
                                        {% if totalVotos > 0 %}
                                            {{ ((res.votos / totalVotos) * 100)|number_format(2, ',', '.') }}%
                                        {% else %}
                                            0,00%
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">Nenhum candidato cadastrado.</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 text-center d-flex justify-content-center gap-3">
        <a href="{{ path('urna_interface') }}" class="btn btn-secondary">Voltar para a Urna</a>

        {% if is_granted('ROLE_ADMIN') and not finalizada %}
            <form action="{{ path('urna_finalizar') }}" method="POST" onsubmit="return confirm('Tem certeza que deseja encerrar a eleição? Esta ação não pode ser desfeita.')">
                <button type="submit" class="btn btn-danger">Encerrar Eleição</button>
            </form>
        {% endif %}
    </div>
</div>
{% endblock %}
