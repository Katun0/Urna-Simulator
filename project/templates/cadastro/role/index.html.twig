{% extends 'base.html.twig' %}

{% block title %}Gestão de Roles{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Perfis de Acesso (Roles)</h1>
        <a href="{{ path('app_cadastro_role_new') }}" class="btn btn-success">
            Novo Perfil
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>Rotas Permitidas</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for role in custom_roles %}
                        <tr>
                            <td>{{ role.id }}</td>
                            <td><span class="badge bg-secondary">{{ role.name }}</span></td>
                            <td>
                                <div class="text-wrap" style="max-width: 400px;">
                                    {% for route in role.routes %}
                                        <code class="small text-muted">{{ route }}</code>{% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a href="{{ path('app_cadastro_role_edit', {'id': role.id}) }}" class="btn btn-primary">Editar</a>
                                    <form method="post" action="{{ path('app_cadastro_role_delete', {'id': role.id}) }}" onsubmit="return confirm('Tem certeza que deseja excluir esta role?');" style="display: inline-block;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ role.id) }}">
                                        <button class="btn btn-danger">Excluir</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">Nenhuma role encontrada.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
