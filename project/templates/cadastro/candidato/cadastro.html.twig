{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1>{{ title }}</h1>

            {% for message in app.flashes('success') %}
                <div class="alert alert-success">
                    {{ message }}
                </div>
            {% endfor %}

            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.Nome, 'Nome do Candidato', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.Nome, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.Numero, 'Número (5 dígitos para vereador)', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.Numero, {'attr': {'class': 'form-control', 'maxlength': 2}}) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.Partido, 'Partido', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.Partido, {'attr': {'class': 'form-select'}}) }}
                </div>

                <div class="mb-4">
                    {{ form_label(form.Foto, 'Foto', {'label_attr': {'class': 'form_label'}}) }}
                    {{ form_widget(form.Foto, {'attr': {'class': 'form-control'}}) }}
                </div>

                <button type="submit" class="btn btn-primary w-100">Cadastrar Candidato</button>
                    {{ form_end(form) }}

            <div class="mt-3 text-center">
                <hr>
                <p class="text-muted small">Utilize o menu superior para navegar entre as outras áreas.</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
