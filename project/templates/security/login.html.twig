{% extends 'base.html.twig' %}

{% block title %}Entrar · Urna Eletrônica{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <form method="post" class="login-card">
                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                {% if app.user %}
                    <div class="mb-3">
                        Você está logado como {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Logout</a>
                    </div>
                {% endif %}

                <span class="text-uppercase small fw-bold text-success">Acesso seguro</span>
                <h1 class="h3 mt-2 mb-1">Bem-vindo de volta</h1>
                <p class="text-secondary mb-4">Entre com seus dados para continuar.</p>

                <div class="mb-3">
                    <label for="inputTituloEleitor" class="form-label">Título de Eleitor</label>
                    <input type="text" value="{{ last_username }}" name="_titulo_eleitor" id="inputTituloEleitor" class="form-control" autocomplete="username" required autofocus>
                </div>

                <div class="mb-3">
                    <label for="inputPassword" class="form-label">Senha</label>
                    <input type="password" name="_password" id="inputPassword" class="form-control" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                {#
                    Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
                    See https://symfony.com/doc/current/security/remember_me.html

                    <div class="checkbox mb-3">
                        <label>
                            <input type="checkbox" name="_remember_me"> Remember me
                        </label>
                    </div>
                #}

                <button class="btn btn-primary w-100" type="submit">
                    Entrar
                </button>

                <div class="mt-3 text-center">
                    Não tem uma conta? <a href="{{ path('app_register') }}">Cadastre-se</a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
