{% extends 'base.html.twig' %}

{% block title %}Urna Eletrônica - Simulação{% endblock %}

{% block body %}
    <style>
        :root {
            --body-gray: #dce2e5;
            --internal-gray: #666666;
            --screen-bg: #111111;
            --key-gray: #d0d0d0;
            --key-text: #111111;
            --confirm-green: #198754;
            --correct-orange: #ed8a32;
            --blank-white: #eeeeee;
        }

        .urna-wrapper {
            background-color: transparent;
            font-family: 'DM Sans', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 0;
            min-height: calc(100vh - 160px);
        }

        .urna-container {
            width: 1000px;
            max-width: 95vw;
            height: 600px;
            background-color: var(--body-gray);
            border-radius: 24px;
            padding: 24px;
            box-shadow: 0 28px 70px rgba(25, 42, 47, .22), inset 0 1px rgba(255,255,255,.8);
            display: flex;
            gap: 30px;
            box-sizing: border-box;
            border: 2px solid #555;
            position: relative;
        }

        /* Screen Area */
        .screen-container {
            flex: 6;
            background-color: #333;
            padding: 10px;
            border-radius: 12px;
            box-shadow: inset 0 0 10px rgba(0,0,0,0.5);
            display: flex;
            flex-direction: column;
        }

        .screen {
            flex: 1;
            background-color: var(--screen-bg);
            color: #fff;
            padding: 20px;
            position: relative;
            box-shadow: inset 0 0 20px rgba(0,0,0,0.8);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .screen-header h1 { font-size: 20px; margin: 0; text-transform: uppercase; }
        .screen-header h2 { font-size: 16px; margin: 5px 0; color: #aaa; }
        .screen-header h3 { font-size: 24px; margin: 0; color: #fff; }

        .number-input-area { display: flex; align-items: center; gap: 10px; margin: 20px 0; }
        .number-label { font-size: 18px; }

        .digit-box {
            width: 40px;
            height: 50px;
            border: 2px solid #555;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 32px;
            font-weight: bold;
            font-family: 'Courier New', Courier, monospace;
        }

        .digit-box.active { border-color: #fff; animation: blink 1s infinite; }
        @keyframes blink { 50% { border-color: transparent; } }

        .candidate-info { flex: 1; display: none; margin-top: 10px; }
        .info-row { margin-bottom: 5px; font-size: 18px; }
        .info-label { color: #aaa; margin-right: 10px; }

        .candidate-photo {
            position: absolute;
            top: 10px;
            right: 10px;
            width: 140px;
            height: 180px;
            border: 2px solid #555;
            background-color: #222;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #444;
            overflow: hidden;
        }

        .candidate-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .status-area { border-top: 2px solid #333; padding-top: 10px; font-size: 16px; text-transform: uppercase; }

        /* Keypad Area */
        .keypad-container {
            flex: 4;
            background-color: #444;
            padding: 20px;
            border-radius: 18px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 15px;
        }

        .keys-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
        .key {
            height: 55px;
            background-color: #333;
            color: white;
            font-size: 24px;
            font-weight: bold;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 9px;
            cursor: pointer;
            border: 1px solid rgba(255,255,255,.08);
            box-shadow: 0 4px #111;
            user-select: none;
            transition: all 0.1s;
        }
        .key:active { box-shadow: 0 0 #111; transform: translateY(4px); }
        .key.zero { grid-column: 2; }

        .action-keys { display: flex; justify-content: space-between; gap: 8px; margin-top: 15px; }
        .action-key {
            flex: 1;
            height: 60px;
            padding: 5px;
            font-size: 12px;
            font-weight: bold;
            text-transform: uppercase;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            border-radius: 5px;
            box-shadow: 0 4px rgba(0,0,0,0.5);
            transition: all 0.1s;
        }
        .action-key:active { box-shadow: 0 0 transparent; transform: translateY(4px); }
        .key-blank { background-color: var(--blank-white); color: #000; }
        .key-correct { background-color: var(--correct-orange); color: #fff; }
        .key-confirm {
            background-color: var(--confirm-green);
            color: #fff;
            height: 70px;
            margin-top: -10px;
            font-size: 16px;
            box-shadow: 0 4px #1b5e20;
        }

        .fim-screen {
            position: absolute;
            inset: 0;
            background-color: var(--screen-bg);
            display: none;
            justify-content: center;
            align-items: center;
            font-size: 100px;
            font-weight: bold;
            letter-spacing: 10px;
            z-index: 10;
            flex-direction: column;
        }

        .comprovante-container {
            display: none;
            position: absolute;
            inset: 0;
            background-color: #fff;
            color: #000;
            padding: 20px;
            z-index: 20;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            font-family: 'Courier New', Courier, monospace;
        }

        .comprovante-box {
            border: 2px dashed #000;
            padding: 20px;
            width: 80%;
        }

        @media (max-width: 900px) {
            .urna-container { flex-direction: column; width: min(620px, 95vw); height: auto; }
            .screen-container { height: 400px; }
        }
    </style>

    <div class="urna-wrapper" data-vote-csrf="{{ csrf_token('api_votar') }}">
        <div class="urna-container">
            <!-- Display Screen -->
            <div class="screen-container">
                <div class="screen">
                    <div class="fim-screen" id="fim-screen">FIM</div>

                    {% if finalizada %}
                        <div class="fim-screen" style="display: flex; font-size: 40px; text-align: center; padding: 20px;">
                            ELEIÇÃO ENCERRADA<br>
                            <span style="font-size: 20px; margin-top: 20px;">Aguarde a apuração oficial.</span>
                        </div>
                    {% endif %}

                    <div class="comprovante-container" id="comprovante-container">
                        <div class="comprovante-box">
                            <h4 class="mb-3">COMPROVANTE DE VOTAÇÃO</h4>
                            <p>Eleição Simulada 2026</p>
                            <hr>
                            <p><strong>Autenticação:</strong><br><span id="comp-auth"></span></p>
                            <p class="small">Guarde esta chave: ela não poderá ser recuperada após sair desta tela.</p>
                            <p><strong>Data/Hora:</strong><br><span id="comp-date"></span></p>
                            <hr>
                            <p class="small">O voto é secreto e sua escolha não consta neste documento.</p>
                            <button class="btn btn-sm btn-dark mt-3" onclick="location.reload()">NOVA VOTAÇÃO</button>
                        </div>
                    </div>

                    <div id="voting-content">
                        <div class="screen-header">
                            <h1>ELEIÇÃO SIMULADA</h1>
                            <h2>SEU VOTO PARA</h2>
                            <h3 id="office-title">PRESIDENTE</h3>
                        </div>

                        <div class="number-input-area">
                            <span class="number-label">NÚMERO:</span>
                            <div id="digit-container" style="display: flex; gap: 10px;">
                                <div class="digit-box active"></div>
                                <div class="digit-box"></div>
                            </div>
                        </div>

                        <div class="candidate-info" id="candidate-info">
                            <div class="candidate-photo" id="candidate-photo-box">FOTO</div>
                            <div class="info-row"><span class="info-label">CANDIDATO:</span> <span id="candidate-name"></span></div>
                            <div class="info-row"><span class="info-label">PARTIDO:</span> <span id="candidate-party"></span></div>
                        </div>

                        <div style="flex: 1;"></div>

                        <div class="status-area" id="status-area">
                            Digite o número do candidato
                        </div>
                    </div>
                </div>
            </div>

            <!-- Keypad -->
            <div class="keypad-container">
                <div class="keys-grid">
                    <div class="key" onclick="pressKey('1')">1</div>
                    <div class="key" onclick="pressKey('2')">2</div>
                    <div class="key" onclick="pressKey('3')">3</div>
                    <div class="key" onclick="pressKey('4')">4</div>
                    <div class="key" onclick="pressKey('5')">5</div>
                    <div class="key" onclick="pressKey('6')">6</div>
                    <div class="key" onclick="pressKey('7')">7</div>
                    <div class="key" onclick="pressKey('8')">8</div>
                    <div class="key" onclick="pressKey('9')">9</div>
                    <div class="key zero" onclick="pressKey('0')">0</div>
                </div>

                <div class="action-keys">
                    <div class="action-key key-blank" onclick="pressBlank()">BRANCO</div>
                    <div class="action-key key-correct" onclick="pressCorrect()">CORRIGE</div>
                    <div class="action-key key-confirm" onclick="pressConfirm()">CONFIRMA</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        let currentNumber = "";
        const maxDigits = 2;
        let candidates = [];
        let isConfirmed = false;
        let isBlank = false;

        async function fetchCandidates() {
            try {
                const response = await fetch('/api/candidatos');
                candidates = await response.json();
            } catch (error) {
                console.error("Failed to fetch candidates", error);
            }
        }

        function updateScreen() {
            const boxes = document.querySelectorAll('.digit-box');
            const statusArea = document.getElementById('status-area');
            const infoArea = document.getElementById('candidate-info');

            boxes.forEach((box, index) => {
                box.textContent = currentNumber[index] || "";
                box.classList.toggle('active', index === currentNumber.length && !isConfirmed && !isBlank);
            });

            if (isBlank) {
                statusArea.textContent = "VOTO EM BRANCO - PRESSIONE CONFIRMAR";
                infoArea.style.display = 'none';
                return;
            }

            if (currentNumber.length === maxDigits) {
                const candidate = candidates.find(c => String(c.numero) === String(currentNumber));
                if (candidate) {
                    document.getElementById('candidate-name').textContent = candidate.nome;
                    document.getElementById('candidate-party').textContent = candidate.partido;

                    const photoBox = document.getElementById('candidate-photo-box');
                    if (candidate.foto) {
                        photoBox.innerHTML = `<img src="data:image/jpeg;base64,${candidate.foto}" alt="Foto do Candidato">`;
                    } else {
                        photoBox.textContent = 'FOTO';
                    }

                    infoArea.style.display = 'block';
                    statusArea.textContent = "Confira as informações do candidato e pressione CONFIRMAR";
                } else {
                    infoArea.style.display = 'none';
                    statusArea.textContent = "Número de candidato não encontrado";
                }
            } else {
                infoArea.style.display = 'none';
                statusArea.textContent = currentNumber.length > 0 ? "Digite todos os dígitos necessários" : "Digite o número do candidato";
            }
        }

        function pressKey(num) {
            {% if finalizada %} return; {% endif %}
            if (isConfirmed || isBlank || currentNumber.length >= maxDigits) return;
            currentNumber += num;
            updateScreen();
        }

        function pressCorrect() {
            {% if finalizada %} return; {% endif %}
            if (isConfirmed) return;
            currentNumber = "";
            isBlank = false;
            updateScreen();
        }

        function pressBlank() {
            {% if finalizada %} return; {% endif %}
            if (isConfirmed) return;
            currentNumber = "";
            isBlank = true;
            updateScreen();
        }

        async function pressConfirm() {
            {% if finalizada %} return; {% endif %}
            if (isConfirmed) return;

            const candidate = candidates.find(c => String(c.numero) === String(currentNumber));
            const isNull = !isBlank && currentNumber.length === maxDigits && !candidate;

            if (isBlank || (currentNumber.length === maxDigits)) {
                try {
                    const response = await fetch('/api/votar', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-Token': document.querySelector('.urna-wrapper').dataset.voteCsrf,
                        },
                        body: JSON.stringify({
                            numero: isBlank ? null : currentNumber,
                            isBranco: isBlank
                        })
                    });

                    const result = await response.json();

                    if (response.ok && result.success) {
                        isConfirmed = true;
                        document.getElementById('fim-screen').style.display = 'flex';

                        // Toca som de confirmação se houver (opcional)

                        setTimeout(() => {
                            document.getElementById('fim-screen').style.display = 'none';
                            document.getElementById('comp-auth').textContent = result.comprovante;
                            document.getElementById('comp-date').textContent = result.data;
                            document.getElementById('comprovante-container').style.display = 'flex';
                        }, 2000);
                    } else {
                        alert(result.error || 'Erro ao processar voto.');
                    }
                } catch (error) {
                    console.error("Erro na votação:", error);
                    alert('Erro de conexão ao enviar voto.');
                }
            }
        }

        fetchCandidates();
    </script>
{% endblock %}
