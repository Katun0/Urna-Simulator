{% extends 'base.html.twig' %}

{% block title %}Editar Usuário{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h1 class="h3 mb-0">Editar Usuário: {{ usuario.Nome }}</h1>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                {{ form_label(form.Nome, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.Nome, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.Nome) }}
                            </div>
                            <div class="col-md-6 mb-3">
                                {{ form_label(form.Email, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.Email, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.Email) }}
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                {{ form_label(form.Idade, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.Idade, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.Idade) }}
                            </div>
                            <div class="col-md-8 mb-3">
                                {{ form_label(form.TituloEleitor, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.TituloEleitor, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.TituloEleitor) }}
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.customRole, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.customRole, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.customRole) }}
                        </div>

                        <div class="card bg-light mb-3">
                            <div class="card-body">
                                <h5 class="card-title">Segurança</h5>
                                <div class="mb-0">
                                    {{ form_label(form.plainPassword, null, {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.plainPassword, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.plainPassword) }}
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">Salvar Alterações</button>
                            <a href="{{ path('app_cadastro_usuario_index') }}" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
